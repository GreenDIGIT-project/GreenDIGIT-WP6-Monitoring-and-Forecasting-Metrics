[Unit]
Description=Shelly to MQTT Sender
After=network.target

[Service]
ExecStart=/usr/bin/python3 /home/pi/greendigit-l3-iot-uth-deployment/core/energy/energy_metrics.py
WorkingDirectory=/home/pi/
StandardOutput=inherit
StandardError=inherit
Restart=always
User=pi

[Install]
WantedBy=multi-user.target
